<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.mapper.PostMapper">

    <select id="queryHotPosts" resultType="com.campus.entity.Post">
        SELECT * FROM tb_post
        WHERE status = 1
        <if test="category != null and category != '' and category != 'all'">
            AND category = #{category}
        </if>
        ORDER BY hot_score DESC, create_time DESC
        LIMIT #{limit}
    </select>
</mapper>